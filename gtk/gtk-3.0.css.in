/* Neon para apps GTK3 (Thunar). Base oscura + acentos cian/magenta. */
@define-color theme_bg_color __BG__;
@define-color theme_fg_color __FG__;
@define-color theme_base_color __BASE__;
@define-color theme_text_color __FG__;
@define-color theme_selected_bg_color __ACCENT__;
@define-color theme_selected_fg_color __BG__;
@define-color theme_unfocused_bg_color __BASE__;
@define-color insensitive_fg_color __MUTED__;

window,
.background {
    background-color: @theme_bg_color;
    color: @theme_fg_color;
}

headerbar,
.titlebar {
    background-image: none;
    background-color: __BASE__;
    color: @theme_fg_color;
    border-bottom: 1px solid __ACCENT_SOFT__;
    box-shadow: none;
}

button {
    background-image: none;
    background-color: __BASE__;
    color: @theme_fg_color;
    border: 1px solid __ACCENT_SOFT__;
    border-radius: 6px;
    box-shadow: none;
}

button:hover {
    background-color: __ACCENT_GLOW__;
    border-color: __ACCENT_STRONG__;
}

button:checked,
button:active {
    background-color: @theme_selected_bg_color;
    color: @theme_selected_fg_color;
    border-color: @theme_selected_bg_color;
}

entry,
searchbar,
spinbutton {
    background-color: @theme_base_color;
    color: @theme_fg_color;
    border: 1px solid __ACCENT_SOFT__;
    border-radius: 6px;
}

entry:focus {
    border-color: @theme_selected_bg_color;
    box-shadow: 0 0 8px __ACCENT_SOFT__;
}

treeview.view,
list,
row {
    background-color: @theme_base_color;
    color: @theme_fg_color;
}

treeview.view:hover,
list row:hover {
    background-color: __ACCENT_GLOW__;
}

treeview.view:selected,
row:selected,
list row:selected {
    background-color: @theme_selected_bg_color;
    color: @theme_selected_fg_color;
}

menubar,
menu,
.menu {
    background-color: __BASE__;
    color: @theme_fg_color;
    border: 1px solid __ACCENT_SOFT__;
}

menuitem:hover {
    background-color: __ACCENT_GLOW__;
}

scrollbar slider {
    background-color: __ACCENT_SOFT__;
    border-radius: 6px;
}

scrollbar slider:hover {
    background-color: @theme_selected_bg_color;
}

separator {
    background-color: __ACCENT_GLOW__;
}

/* Thunar */
window.thunar,
.thunar {
    background-color: @theme_bg_color;
}

.thunar toolbar {
    background-color: __BASE__;
    border-bottom: 1px solid __ACCENT_GLOW__;
}

.thunar .sidebar {
    background-color: #070b13;
    border-right: 1px solid __ACCENT_GLOW__;
}

.thunar .sidebar row:selected {
    background-color: __ACCENT_GLOW__;
    color: @theme_fg_color;
    box-shadow: inset 3px 0 0 @theme_selected_bg_color;
}

.thunar .path-bar button {
    border-radius: 5px;
}

.thunar statusbar {
    background-color: __BASE__;
    color: __ACCENT__;
    border-top: 1px solid __ACCENT_GLOW__;
}
