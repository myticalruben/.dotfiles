{
    "label" : "lock",
    "action" : "hyprlock",
    "text" : "K",
    "keybind" : "k"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "text" : "U",
    "keybind" : "u"
}
{
    "label" : "logout",
    "action" : "session-splash exit logout || hyprctl dispatch 'hl.dsp.exit()'",
    "text" : "L",
    "keybind" : "l"
}
{
    "label" : "reboot",
    "action" : "session-splash exit reboot || systemctl reboot",
    "text" : "R",
    "keybind" : "r"
}
{
    "label" : "shutdown",
    "action" : "session-splash exit shutdown || systemctl poweroff",
    "text" : "S",
    "keybind" : "s"
}
