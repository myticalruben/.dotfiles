#!/usr/bin/env bash
#
# Arranque de la sesion: sin splash ni logo, solo un fundido suave del fondo.
# Lo llama una sola vez hypr/modules/autostart.lua.
#
# Primero se levanta awww y se restaura el wallpaper con transicion fade; cuando
# termina, aparecen waybar y los servicios. Asi la sesion entra desde negro
# hacia el fondo en vez de mostrar una pantalla de carga.

set -u

wallpaper="${1:-$HOME/Pictures/Wallpapers/01.png}"

# El fondo primero: el fundido se ve sobre el escritorio vacio y la barra
# aparece cuando el wallpaper ya esta pintado.
awww-daemon >/dev/null 2>&1 &
wallpaper restore "$wallpaper" >/dev/null 2>&1 || true

waybar="${XDG_CONFIG_HOME:-$HOME/.config}/waybar/scripts/launch-waybar.sh"
[ -x "$waybar" ] && "$waybar" >/dev/null 2>&1 &

dunst >/dev/null 2>&1 &
nm-applet >/dev/null 2>&1 &
wl-paste --type text --watch cliphist store >/dev/null 2>&1 &
wl-paste --type image --watch cliphist store >/dev/null 2>&1 &
