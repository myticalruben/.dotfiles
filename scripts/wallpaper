#!/usr/bin/env bash
#
# Pone un fondo de pantalla y lo recuerda, para volver a ponerlo tal cual en el
# siguiente inicio de sesión.
#
# awww trae su propio `awww restore`, pero se apoya en una caché que vive en un
# directorio con el número de versión dentro (~/.cache/awww/0.12.1/) y que
# `awww clear-cache` borra: al actualizar el paquete o limpiar la caché el
# escritorio arrancaría en negro. Así que la elección se guarda aparte, en
# $XDG_STATE_HOME, que no es de nadie más, y hay un fondo de respaldo para
# cuando todavía no se ha elegido ninguno.
#
# Lo llaman quickshell/hyprquickpaper/commands.sh (`set`, al elegir un fondo en
# el selector) y hypr/modules/autostart.lua (`restore`, al arrancar la sesión).

set -u

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/hypr"
STATE_FILE="$STATE_DIR/wallpaper"

command -v awww >/dev/null 2>&1 || { echo "awww no está en el PATH" >&2; exit 1; }

# La ruta guardada puede haber dejado de valer: la imagen se borró, se movió, o
# el disco donde estaba no está montado. Comprobarlo cuesta nada y evita el
# caso feo, que es pedirle a awww un archivo que no existe y quedarse sin fondo
# ninguno al iniciar sesión.
usable() {
    [[ -n "${1:-}" && -f "$1" && -r "$1" ]]
}

saved() {
    [[ -f "$STATE_FILE" ]] && head -n 1 "$STATE_FILE"
}

remember() {
    mkdir -p "$STATE_DIR"
    printf '%s\n' "$1" > "$STATE_FILE"
}

# awww-daemon se lanza en el mismo bloque de arranque que esto, así que cuando
# `restore` corre todavía puede no aceptar conexiones. Antes había un `sleep 1`
# a ojo; esto espera a que el demonio responda de verdad, y como mucho 10 s.
wait_for_daemon() {
    for _ in $(seq 50); do
        awww query >/dev/null 2>&1 && return 0
        sleep 0.2
    done
    return 1
}

case "${1:-}" in
    set)
        path="${2:-}"
        usable "$path" || { echo "uso: wallpaper set <imagen>" >&2; exit 2; }

        awww img "$path" -t random --transition-duration 1 || exit 1
        remember "$path"
        ;;

    restore)
        # El segundo argumento es el fondo por defecto: solo se usa mientras no
        # haya ninguno elegido, o si el guardado ya no existe. Lo pasa
        # autostart.lua, que es quien conoce el valor de modules/local.lua.
        #
        # No se guarda lo restaurado: el archivo de estado es "lo que eligió el
        # usuario", y si se escribiera aquí el fondo por defecto quedaría
        # congelado y cambiarlo en local.lua dejaría de tener efecto.
        path="$(saved)"
        usable "$path" || path="${2:-}"
        usable "$path" || { echo "no hay ningún fondo que poner" >&2; exit 1; }

        wait_for_daemon || { echo "awww-daemon no responde" >&2; exit 1; }

        # Sin transición: al arrancar no hay imagen previa desde la que fundir,
        # el efecto no se ve y solo retrasa la aparición del escritorio.
        awww img "$path" -t none || exit 1
        ;;

    *)
        echo "uso: wallpaper [set <imagen> | restore [imagen-por-defecto]]" >&2
        exit 2
        ;;
esac
